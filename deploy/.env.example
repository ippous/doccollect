# Copier en /opt/doccollect/<env>/.env et compléter. Ne jamais committer le vrai fichier.
# Générer un secret : openssl rand -base64 32

# --- Environnement : dev | test | prod ---
DC_ENV=test
DC_IMAGE_TAG=test
DC_PUBLIC_URL=https://doccollect-test.jaume-eric.com
DC_ENV_LABEL=Test
# Réseau Docker du reverse proxy HTTPS (sur le VPS actuel : shetland-registre_default)
DC_PROXY_NETWORK=shetland-registre_default
# Production : Production ; dev et test : Staging
ASPNETCORE_ENVIRONMENT=Staging

# --- Base de données ---
POSTGRES_PASSWORD=change-me

# --- Chiffrement des documents (clé maître AES-256, 32 octets en base64) ---
# Rotation : ajouter une nouvelle clé et changer l'identifiant ; garder les anciennes (variables Encryption__Keys__<id>)
# tant que des documents chiffrés avec elles existent.
DC_ENCRYPTION_KEY_ID=k2026
DC_ENCRYPTION_KEY=

# --- Premier administrateur (ignoré s'il existe déjà un admin) ---
DC_ADMIN_EMAIL=
DC_ADMIN_PASSWORD=

# --- Comptes nommés créés au démarrage (suffixe : -dev, -tst, rien en prod) ---
# Connexion possible par identifiant ou par e-mail ; 2FA demandée à la première connexion.
# Le client (Provider) reçoit les demandes adressées à son e-mail.
DC_USER_ADMIN=ippous-admin-tst
DC_USER_ADMIN_EMAIL=
DC_USER_ADMIN_PASSWORD=
DC_USER_REQUESTER=ippous-requesteur-tst
DC_USER_REQUESTER_EMAIL=
DC_USER_REQUESTER_PASSWORD=
DC_USER_REQUESTER_TENANT=ippous
DC_USER_REQUESTER_TENANT_NAME=Ippous
DC_USER_CUSTOMER=ippous-customer-tst
DC_USER_CUSTOMER_EMAIL=
DC_USER_CUSTOMER_PASSWORD=

# --- E-mail ---
# dev/test : capture par Mailpit (lancer avec --profile mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_SUBJECT_PREFIX=[TEST]
MAILPIT_UI_PORT=8026
# prod (Hostinger) :
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURITY=SslOnConnect
# SMTP_USERNAME=no-reply@jaume-eric.com
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@jaume-eric.com
# SMTP_SUBJECT_PREFIX=

# --- IA (option payante, désactivée par défaut) ---
AI_MISTRAL_ENABLED=false
AI_MISTRAL_KEY=
AI_ANTHROPIC_ENABLED=false
AI_ANTHROPIC_KEY=
