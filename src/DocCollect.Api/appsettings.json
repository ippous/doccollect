{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=doccollect;Username=doccollect;Password=doccollect"
  },
  "App": {
    "PublicBaseUrl": "https://localhost:5001",
    "EnvironmentLabel": null,
    "InvitationValidityDays": 14,
    "ReminderIntervalDays": 7,
    "MaxReminders": 5
  },
  "Auth": {
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "RateLimitPerMinute": 20
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Workers": {
    "Enabled": true
  },
  "Storage": {
    "FallbackLocalPath": "/data/storage"
  },
  "Encryption": {
    "CurrentKeyId": "",
    "Keys": {},
    "ChunkSize": 65536
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@jaume-eric.com",
    "FromName": "DocCollect"
  },
  "Ai": {
    "MaxDocumentSizeMb": 10,
    "Providers": {
      "mistral-eu": {
        "Kind": "openai-compatible",
        "DisplayName": "Mistral AI",
        "Region": "UE (France)",
        "BaseUrl": "https://api.mistral.ai/v1",
        "Model": "mistral-small-latest",
        "SupportsPdf": false,
        "Enabled": false
      },
      "anthropic": {
        "Kind": "anthropic",
        "DisplayName": "Anthropic Claude",
        "Region": "US",
        "BaseUrl": "https://api.anthropic.com/v1",
        "Model": "claude-haiku-5-5",
        "Enabled": false
      },
      "azure-openai-fr": {
        "Kind": "openai-compatible",
        "DisplayName": "Azure OpenAI",
        "Region": "UE (France Central)",
        "BaseUrl": "https://VOTRE-RESSOURCE.openai.azure.com/openai/deployments/VOTRE-DEPLOIEMENT",
        "AuthHeader": "api-key",
        "QueryString": "api-version=2024-10-21",
        "SupportsPdf": false,
        "Enabled": false
      },
      "ollama-local": {
        "Kind": "openai-compatible",
        "DisplayName": "Modèle local (Ollama)",
        "Region": "Serveur DocCollect",
        "BaseUrl": "http://ollama:11434/v1",
        "Model": "llama3.2-vision",
        "Enabled": false
      }
    }
  },
  "Seed": {
    "AdminEmail": null,
    "AdminPassword": null,
    "PublicTemplates": true
  }
}
