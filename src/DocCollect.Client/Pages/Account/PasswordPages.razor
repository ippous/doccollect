@page "/forgot-password"
@page "/reset-password"
@attribute [AllowAnonymous]
@inject IHttpClientFactory Http
@inject NavigationManager Nav

<PageTitle>Mot de passe — DocCollect</PageTitle>

<div class="content narrow" style="padding:0">
    <div class="card">
        @if (Code is null)
        {
            <h1>Mot de passe oublié</h1>
            @if (_sent)
            {
                <ErrorAlert Kind="ok" Message="Si un compte existe pour cette adresse, un lien de réinitialisation vient d'être envoyé." />
            }
            else
            {
                <form @onsubmit="ForgotAsync" @onsubmit:preventDefault>
                    <label for="email">Adresse e-mail</label>
                    <input id="email" type="email" autocomplete="username" @bind="_email" required />
                    <button class="btn primary block" style="margin-top:12px" disabled="@_busy">Recevoir un lien</button>
                </form>
            }
        }
        else
        {
            <h1>Nouveau mot de passe</h1>
            @if (_done)
            {
                <ErrorAlert Kind="ok" Message="Mot de passe modifié." />
                <a class="btn primary" href="login">Se connecter</a>
            }
            else
            {
                <form @onsubmit="ResetAsync" @onsubmit:preventDefault>
                    <label for="pwd">Nouveau mot de passe</label>
                    <input id="pwd" type="password" autocomplete="new-password" @bind="_password" required minlength="10" />
                    <ErrorAlert Message="@_error" />
                    <button class="btn primary block" style="margin-top:12px" disabled="@_busy">Enregistrer</button>
                </form>
            }
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }
    private string _email = "", _password = "";
    private string? _error;
    private bool _busy, _sent, _done;

    private async Task ForgotAsync()
    {
        _busy = true;
        try { await Http.CreateClient("anonymous").PostAsJsonAsync("api/auth/forgot-password", new ForgotPasswordRequest(_email)); _sent = true; }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            using var resp = await Http.CreateClient("anonymous").PostAsJsonAsync("api/auth/reset-password",
                new ResetPasswordRequest(Email ?? "", Code ?? "", _password));
            if (resp.IsSuccessStatusCode) _done = true;
            else _error = (await resp.Content.ReadFromJsonAsync<ApiError>())?.Message ?? "Lien invalide ou expiré.";
        }
        finally { _busy = false; }
    }
}
